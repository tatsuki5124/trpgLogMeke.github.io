  "version": "2.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^10.14.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
